@app.after_request
def add_cors_headers(response):
    origin = request.headers.get("Origin")
    if origin == "http://192.168.0.4:8080":
        response.headers["Access-Control-Allow-Origin"] = origin
        response.headers["Access-Control-Allow-Methods"] = "GET, POST, PUT, DELETE, OPTIONS"
        response.headers["Access-Control-Allow-Headers"] = "Content-Type"
        response.headers["Vary"] = "Origin"
    return response


def connect():
    db = sqlite3.connect(DB)
    db.row_factory = sqlite3.Row
    return db


def initialize():
    with connect() as db:
        db.execute("""
            CREATE TABLE IF NOT EXISTS playlists (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL,
                playlist_type TEXT NOT NULL,
                server_url TEXT,
                username TEXT,
                password TEXT,
                source_url TEXT,
                file_path TEXT,
                is_default INTEGER DEFAULT 0,
                created_at TEXT DEFAULT CURRENT_TIMESTAMP,
                updated_at TEXT DEFAULT CURRENT_TIMESTAMP
            )
        """)
        db.execute("""
            CREATE TABLE IF NOT EXISTS media_items (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                playlist_id INTEGER NOT NULL,
                media_type TEXT NOT NULL,
                category TEXT NOT NULL,
                group_name TEXT,
                title TEXT NOT NULL,
                logo TEXT,
                stream_url TEXT NOT NULL,
                adult INTEGER DEFAULT 0
            )
        """)
        db.execute("""
            CREATE INDEX IF NOT EXISTS idx_media_category
            ON media_items(playlist_id, media_type, category, adult)
        """)
        db.execute("""
            CREATE INDEX IF NOT EXISTS idx_media_title
            ON media_items(playlist_id, media_type, category, title COLLATE NOCASE)
        """)
        db.execute("""
            CREATE TABLE IF NOT EXISTS catalog_meta (
                playlist_id INTEGER PRIMARY KEY,
                file_path TEXT NOT NULL,
                file_size INTEGER NOT NULL,
                file_mtime REAL NOT NULL,
                item_count INTEGER NOT NULL,
                indexed_at TEXT DEFAULT CURRENT_TIMESTAMP
            )
        """)


