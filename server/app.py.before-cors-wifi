# CATÁLOGO M3U - INDEXAÇÃO E CONSULTA PAGINADA
# ============================================================

_catalog_jobs = {}
_catalog_jobs_lock = threading.Lock()
_CATALOG_BATCH_SIZE = 1000


def classify_m3u_group(group):
    raw = (group or "").strip()
    normalized = raw.casefold()

    if normalized.startswith("canais |"):
        return "live", raw.split("|", 1)[1].strip() or "Outros", 0

    if normalized.startswith("filmes |"):
        category = raw.split("|", 1)[1].strip() or "Outros"
        if category.casefold().startswith("[xxx]"):
            return "movies", "Adultos", 1
        return "movies", category, 0

    if normalized.startswith("series |"):
        return "series", raw.split("|", 1)[1].strip() or "Outros", 0

    if normalized.startswith("[xxx]"):
        return "movies", "Adultos", 1

    if normalized in ("novelas", "programas de tv"):
        return "series", raw, 0

    other_groups = {
        "documentarios", "documentários", "cursos", "esportes",
        "shows", "stand up comedy", "reels shorts"
    }

    if normalized in other_groups:
        return "movies", "Outros", 0

    return "movies", "Outros", 0


def parse_m3u_extinf(line):
    metadata, separator, title = line.partition(",")
    if not separator:
        title = metadata
    attrs = dict(re.findall(r'([A-Za-z0-9_-]+)="([^"]*)"', metadata))
    group = attrs.get("group-title", "").strip()
    media_type, category, adult = classify_m3u_group(group)

    return (
        media_type,
        category,
        group,
        title.strip() or attrs.get("tvg-name", "").strip() or "Sem título",
        attrs.get("tvg-logo", "").strip(),
        adult
    )


def catalog_job_update(playlist_id, **values):
    with _catalog_jobs_lock:
        current = _catalog_jobs.setdefault(playlist_id, {})
        current.update(values)


def index_m3u_catalog(playlist_id, file_path):
    path = Path(file_path)

    try:
        if not path.is_file():
            raise FileNotFoundError("Arquivo da playlist não encontrado.")

        file_size = path.stat().st_size
        file_mtime = path.stat().st_mtime

        catalog_job_update(
            playlist_id,
            status="indexing",
            progress=0,
            indexed=0,
            total_bytes=file_size,
            message="Lendo playlist..."
        )

        db = connect()
        count = 0
        batch = []

        try:
            db.execute("BEGIN")
            db.execute(
                "DELETE FROM media_items WHERE playlist_id=?",
                (playlist_id,)
            )

            pending = None
            first_content = True
            bytes_read = 0

            with path.open("r", encoding="utf-8-sig", errors="replace") as source:
                for raw_line in source:
                    bytes_read += len(raw_line.encode("utf-8", errors="replace"))
                    line = raw_line.strip()

                    if not line:
                        continue

                    if first_content:
                        first_content = False
                        if not line.startswith("#EXTM3U"):
                            raise ValueError("O arquivo não possui cabeçalho M3U válido.")
                        continue

                    if line.startswith("#EXTINF:"):
                        pending = parse_m3u_extinf(line)
                        continue

                    if pending and not line.startswith("#"):
                        media_type, category, group, title, logo, adult = pending

                        batch.append((
                            playlist_id,
                            media_type,
                            category,
                            group,
                            title,
                            logo,
                            line,
                            adult
                        ))
                        pending = None

                        if len(batch) >= _CATALOG_BATCH_SIZE:
                            db.executemany("""
                                INSERT INTO media_items
                                (playlist_id,media_type,category,group_name,
                                 title,logo,stream_url,adult)
                                VALUES (?,?,?,?,?,?,?,?)
                            """, batch)

                            count += len(batch)
                            batch.clear()

                            catalog_job_update(
                                playlist_id,
                                indexed=count,
                                progress=min(99, int(bytes_read * 100 / max(file_size, 1))),
                                message=f"Indexando conteúdo: {count:,} itens"
                            )

            if first_content:
                raise ValueError("A playlist está vazia.")

            if batch:
                db.executemany("""
                    INSERT INTO media_items
                    (playlist_id,media_type,category,group_name,
                     title,logo,stream_url,adult)
                    VALUES (?,?,?,?,?,?,?,?)
                """, batch)
                count += len(batch)

            db.execute("""
                INSERT OR REPLACE INTO catalog_meta
                (playlist_id,file_path,file_size,file_mtime,item_count,indexed_at)
                VALUES (?,?,?,?,?,CURRENT_TIMESTAMP)
            """, (playlist_id, str(path), file_size, file_mtime, count))

            db.commit()

        except Exception:
            db.rollback()
            raise
        finally:
            db.close()

        catalog_job_update(
            playlist_id,
            status="ready",
            progress=100,
            indexed=count,
            total=count,
            message=f"Catálogo pronto: {count:,} itens."
        )

    except Exception:
        catalog_job_update(
            playlist_id,
            status="error",
            message="Não foi possível indexar a playlist. Verifique o arquivo M3U."
        )


def start_catalog_index(playlist_id, file_path):
    path = Path(file_path)

    if not path.is_file():
        return {
            "status": "error",
            "message": "Arquivo da playlist não encontrado."
        }

    stat = path.stat()

    with _catalog_jobs_lock:
        current = _catalog_jobs.get(playlist_id, {})
        if current.get("status") == "indexing":
            return dict(current)

    with connect() as db:
        meta = db.execute("""
            SELECT file_path,file_size,file_mtime,item_count
            FROM catalog_meta WHERE playlist_id=?
        """, (playlist_id,)).fetchone()

    if (
        meta
        and meta["file_path"] == str(path)
        and meta["file_size"] == stat.st_size
        and meta["file_mtime"] == stat.st_mtime
    ):
        result = {
            "status": "ready",
            "progress": 100,
            "indexed": meta["item_count"],
            "total": meta["item_count"],
            "message": "Catálogo já indexado."
        }
        catalog_job_update(playlist_id, **result)
        return result

    catalog_job_update(
        playlist_id,
        status="indexing",
        progress=0,
        indexed=0,
        total_bytes=stat.st_size,
        message="Preparando indexação..."
    )

    thread = threading.Thread(
        target=index_m3u_catalog,
        args=(playlist_id, str(path)),
        daemon=True
    )
    thread.start()

    return {
        "status": "indexing",
        "progress": 0,
        "message": "Indexação iniciada."
    }


def get_active_m3u():
    with connect() as db:
        row = db.execute("""
            SELECT id,file_path,playlist_type
            FROM playlists WHERE is_default=1 LIMIT 1
        """).fetchone()

    if not row:
        return None, "Nenhuma playlist está selecionada."

    if row["playlist_type"] != "m3u_url":
        return None, "O catálogo M3U ainda não está disponível para esta conexão."

    if not row["file_path"]:
        return None, "A playlist selecionada ainda não possui arquivo baixado."

    return row, None


@app.post("/api/catalog/index")
def api_catalog_index():
    playlist, error = get_active_m3u()
    if error:
        return jsonify({"error": error}), 409

    result = start_catalog_index(
        playlist["id"],
        playlist["file_path"]
    )
    return jsonify(result)


