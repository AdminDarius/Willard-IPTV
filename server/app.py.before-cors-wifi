    playlist, error = get_active_m3u()
    if error:
        return jsonify({"status": "unavailable", "message": error}), 409

    playlist_id = playlist["id"]

    with _catalog_jobs_lock:
        job = _catalog_jobs.get(playlist_id)

    if job:
        return jsonify(dict(job))

    with connect() as db:
        meta = db.execute("""
            SELECT item_count,file_path,file_size,file_mtime
            FROM catalog_meta WHERE playlist_id=?
        """, (playlist_id,)).fetchone()

    if meta:
        path = Path(playlist["file_path"])
        if path.is_file():
            stat = path.stat()
            if (
                meta["file_path"] == str(path)
                and meta["file_size"] == stat.st_size
                and meta["file_mtime"] == stat.st_mtime
            ):
                return jsonify({
                    "status": "ready",
                    "progress": 100,
                    "indexed": meta["item_count"],
                    "total": meta["item_count"],
                    "message": "Catálogo pronto."
                })

    return jsonify({
        "status": "not_started",
        "progress": 0,
        "message": "O catálogo ainda não foi indexado."
    })


@app.get("/api/catalog/categories")
def api_catalog_categories():
    playlist, error = get_active_m3u()
    if error:
        return jsonify({"error": error}), 409

    media_type = request.args.get("type", "")
    if media_type not in ("live", "movies", "series"):
        return jsonify({"error": "Tipo de catálogo inválido."}), 400

    with connect() as db:
        rows = db.execute("""
            SELECT category,COUNT(*) AS item_count
            FROM media_items
            WHERE playlist_id=? AND media_type=?
            GROUP BY category
            ORDER BY category COLLATE NOCASE
        """, (playlist["id"], media_type)).fetchall()

    return jsonify({"categories": [dict(row) for row in rows]})


@app.get("/api/catalog/items")
def api_catalog_items():
    playlist, error = get_active_m3u()
    if error:
        return jsonify({"error": error}), 409

    media_type = request.args.get("type", "")
    category = request.args.get("category", "")
    if media_type not in ("live", "movies", "series") or not category:
        return jsonify({"error": "Informe o tipo e a categoria."}), 400

    try:
        page = max(1, int(request.args.get("page", "1")))
        limit = min(100, max(1, int(request.args.get("limit", "40"))))
    except ValueError:
        return jsonify({"error": "Paginação inválida."}), 400

    offset = (page - 1) * limit

    with connect() as db:
        total = db.execute("""
            SELECT COUNT(*) FROM media_items
            WHERE playlist_id=? AND media_type=? AND category=?
        """, (playlist["id"], media_type, category)).fetchone()[0]

        rows = db.execute("""
            SELECT id,title,logo,category
            FROM media_items
            WHERE playlist_id=? AND media_type=? AND category=?
            ORDER BY title COLLATE NOCASE
            LIMIT ? OFFSET ?
        """, (playlist["id"], media_type, category, limit, offset)).fetchall()

    return jsonify({
        "items": [dict(row) for row in rows],
        "page": page,
        "limit": limit,
        "total": total,
        "pages": (total + limit - 1) // limit
    })



