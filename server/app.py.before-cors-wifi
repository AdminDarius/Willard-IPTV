def validate_m3u(source):
    from urllib.error import HTTPError, URLError
    from urllib.parse import urljoin, urlsplit
    from urllib.request import Request, HTTPRedirectHandler, build_opener

    class NoRedirect(HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            return None

    try:
        current = source
        redirects = 0
        opener = build_opener(NoRedirect())
        headers = {
            "User-Agent": (
                "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
                "AppleWebKit/537.36 (KHTML, like Gecko) "
                "Chrome/122.0.0.0 Safari/537.36"
            ),
            "Accept": "*/*",
            "Connection": "close"
        }

        for attempt in range(3):
            try:
                for _ in range(6):
                    parsed = urlsplit(current)
                    if parsed.scheme not in ("http", "https") or not parsed.hostname:
                        return False, "Redirecionamento para endereço inválido."

                    req = Request(current, headers=headers, method="GET")
                    try:
                        response = opener.open(req, timeout=20)
                    except HTTPError as exc:
                        response = exc

                    with response:
                        status = response.code
                        if status in (301, 302, 303, 307, 308):
                            location = response.headers.get("Location")
                            if not location or redirects >= 5:
                                return False, "Limite de redirecionamentos excedido."
                            current = urljoin(current, location)
                            redirects += 1
                            continue

                        if status in (429,) or 500 <= status <= 599:
                            raise RuntimeError("HTTP_TEMPORARIO")

                        if status not in (200, 206):
                            return False, "O provedor respondeu HTTP " + str(status) + "."

                        body = response.read(65536)
                        normalized = body.lstrip(b"\xef\xbb\xbf \t\r\n")

                        if normalized.startswith(b"#EXTM3U"):
                            return True, "Playlist M3U acessível e confirmada."

                        if not normalized:
                            return False, "O servidor respondeu sem enviar conteúdo."

                        return False, "O endereço respondeu, mas não retornou o cabeçalho M3U."

                return False, "Limite de redirecionamentos excedido."

            except RuntimeError as exc:
                if str(exc) != "HTTP_TEMPORARIO":
                    return False, "Falha durante a validação da playlist."
            except (URLError, TimeoutError, OSError):
                if attempt == 2:
                    return False, "Não foi possível estabelecer conexão com o provedor."
            except Exception:
                return False, "Falha inesperada durante a validação da playlist."

            import time
            time.sleep(1 + attempt)

        return False, "Não foi possível validar a playlist após três tentativas."
    except Exception:
        return False, "Falha inesperada ao validar a playlist."


def validate_xtream(server, username, password):
    try:
        parsed = urllib.parse.urlsplit(server)
        if parsed.scheme not in ("http", "https") or not parsed.netloc:
            return False, "Endereço do servidor Xtream inválido."

        endpoint = server.rstrip("/") + "/player_api.php"
        query = urllib.parse.urlencode({
            "username": username,
            "password": password
        })
        req = urllib.request.Request(
            endpoint + "?" + query,
            headers={"User-Agent": "Willard IPTV/1.0"}
        )

        with urllib.request.urlopen(req, timeout=15) as response:
            raw = response.read(1024 * 1024 + 1)

        if len(raw) > 1024 * 1024:
            return False, "Resposta do servidor muito grande."

        data = json.loads(raw.decode("utf-8-sig"))
        info = data.get("user_info", {}) if isinstance(data, dict) else {}
        auth = info.get("auth")

        if str(auth) != "1" and auth is not True:
            return False, "Usuário ou senha recusados pelo servidor IPTV."

        status = str(info.get("status", "")).lower()
        if status and status not in ("active", "enabled"):
            return False, "A conta IPTV não está ativa."

        return True, "Acesso Xtream Codes validado."

    except Exception:
        return False, "Não foi possível validar o acesso Xtream Codes."


def download_m3u(playlist_id, source):
    from urllib.parse import urlsplit

    parsed = urlsplit(source)
    if parsed.scheme not in ("http", "https") or not parsed.hostname:
        return False, "Endereço M3U inválido.", None

    folder = DATA / "playlists"
    folder.mkdir(parents=True, exist_ok=True)

    destination = folder / f"playlist_{playlist_id}.m3u"
    temporary = None

    try:
        req = urllib.request.Request(
            source,
            headers={
                "User-Agent": (
                    "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
                    "AppleWebKit/537.36 Chrome/122.0 Safari/537.36"
                ),
                "Accept": "*/*",
                "Connection": "close"
            }
        )

        with urllib.request.urlopen(req, timeout=30) as response:
            final_url = urlsplit(response.geturl())
            if final_url.scheme not in ("http", "https") or not final_url.hostname:
                return False, "Endereço de redirecionamento inválido.", None

            if response.status != 200:
                return False, "O provedor não disponibilizou a playlist.", None

            temporary = folder / f".playlist_{playlist_id}.part"
            total = 0
            first = True

            with temporary.open("wb") as output:
                while True:
                    chunk = response.read(1024 * 1024)
                    if not chunk:
                        break

                    total += len(chunk)
                    if total > 512 * 1024 * 1024:
                        raise ValueError("A playlist excede o limite de 512 MB.")

                    if first:
                        normalized = chunk.lstrip(b"\xef\xbb\xbf \t\r\n")
                        if not normalized.startswith(b"#EXTM3U"):
                            raise ValueError("O conteúdo recebido não é uma playlist M3U.")
                        first = False

                    output.write(chunk)

            if total == 0 or first:
                raise ValueError("O provedor retornou uma playlist vazia.")

        os.replace(temporary, destination)
        return True, "Playlist M3U baixada e validada.", str(destination)

    except urllib.error.HTTPError as exc:
        message = f"O provedor respondeu HTTP {exc.code}."
    except urllib.error.URLError:
        message = "Não foi possível conectar ao provedor M3U."
    except TimeoutError:
        message = "O tempo limite para baixar a playlist foi excedido."
    except ValueError as exc:
        message = str(exc)
    except Exception:
        message = "Falha durante o download da playlist."

    if temporary and temporary.exists():
        temporary.unlink()

    return False, message, None


@app.put("/api/playlists/<int:playlist_id>/select")
def select_playlist(playlist_id):
    with connect() as db:
        playlist = db.execute(
            "SELECT * FROM playlists WHERE id=?",
            (playlist_id,)
        ).fetchone()

    if not playlist:
        return jsonify({"error": "Playlist não encontrada."}), 404

    kind = playlist["playlist_type"]
    file_path = playlist["file_path"]

    if kind == "m3u_url":
        valid, message, file_path = download_m3u(
            playlist_id, playlist["source_url"]
        )
        if not valid:
            return jsonify({"error": message}), 502

    elif kind == "xtream":
        valid, message = validate_xtream(
            playlist["server_url"],
            playlist["username"],
            playlist["password"]
        )
        if not valid:
            return jsonify({"error": message}), 502

    else:
        return jsonify({"error": "Tipo de playlist não suportado."}), 400

    with connect() as db:
        exists = db.execute(
            "SELECT id FROM playlists WHERE id=?",
            (playlist_id,)
        ).fetchone()

        if not exists:
            return jsonify({"error": "Playlist não encontrada."}), 404

        db.execute("UPDATE playlists SET is_default=0")
        db.execute("""
            UPDATE playlists
            SET is_default=1, file_path=?, updated_at=CURRENT_TIMESTAMP
            WHERE id=?
        """, (file_path, playlist_id))

    return jsonify({
        "success": True,
        "id": playlist_id,
        "playlist_type": kind,
        "message": message
    })


@app.post("/api/playlists")
def add_playlist():
    data = request.get_json(silent=True) or {}
    name = str(data.get("name", "")).strip()
    kind = data.get("playlist_type")

    if not name:
        return jsonify({"error": "Informe o nome da playlist"}), 400

    if kind == "xtream":
        server = str(data.get("server_url", "")).strip().rstrip("/")
        username = str(data.get("username", "")).strip()
        password = str(data.get("password", "")).strip()
        if not all((server, username, password)):
            return jsonify({"error": "Preencha servidor, usuário e senha"}), 400
        values = (name, kind, server, username, password, None)
    elif kind == "m3u_url":
        source = str(data.get("source_url", "")).strip()
        if not source.startswith(("http://", "https://")):
            return jsonify({"error": "URL M3U inválida"}), 400
        values = (name, kind, None, None, None, source)
    else:
        return jsonify({"error": "Tipo de playlist inválido"}), 400

    with connect() as db:
        cur = db.execute("""
            INSERT INTO playlists
            (name,playlist_type,server_url,username,password,source_url)
            VALUES (?,?,?,?,?,?)
        """, values)
        playlist_id = cur.lastrowid

    return jsonify({"success": True, "id": playlist_id}), 201


@app.delete("/api/playlists/<int:playlist_id>")
def delete_playlist(playlist_id):
    with connect() as db:
        cur = db.execute("DELETE FROM playlists WHERE id=?", (playlist_id,))
    if not cur.rowcount:
